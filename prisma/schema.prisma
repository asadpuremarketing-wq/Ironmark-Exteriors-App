// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  EMPLOYEE
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(EMPLOYEE)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

enum CustomerStatus {
  LEAD
  ACTIVE_CUSTOMER
  PAST_CUSTOMER
  DO_NOT_CONTACT
}

model Customer {
  id             String         @id @default(cuid())
  firstName      String         @map("first_name")
  lastName       String         @map("last_name")
  phone          String
  email          String?
  streetAddress  String?        @map("street_address")
  city           String?
  province       String         @default("Ontario")
  postalCode     String?        @map("postal_code")
  notes          String?
  status         CustomerStatus @default(LEAD)

  emailMarketingConsent Boolean @default(false) @map("email_marketing_consent")
  smsMarketingConsent   Boolean @default(false) @map("sms_marketing_consent")
  doNotContact          Boolean @default(false) @map("do_not_contact")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  leads Lead[]
  jobs  Job[]

  @@index([phone])
  @@index([email])
  @@index([lastName, firstName])
  @@map("customers")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUOTE_NEEDED
  QUOTE_SENT
  FOLLOW_UP
  BOOKED
  LOST
  NO_RESPONSE
}

model Lead {
  id               String     @id @default(cuid())
  customerId       String     @map("customer_id")
  customer         Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceRequested String     @map("service_requested")
  // Lead source is a plain string (validated against a curated list in
  // app code, see src/lib/leads.ts) rather than a DB enum, so new sources
  // can be added later without a migration.
  leadSource       String     @map("lead_source")
  estimatedValue   Decimal?   @map("estimated_value") @db.Decimal(10, 2)
  status           LeadStatus @default(NEW)
  dateReceived     DateTime   @default(now()) @map("date_received")
  followUpDate     DateTime?  @map("follow_up_date")
  notes            String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  job Job?

  @@index([customerId])
  @@index([status])
  @@index([followUpDate])
  @@map("leads")
}

enum JobStatus {
  BOOKED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  RESCHEDULED
}

model Job {
  id         String   @id @default(cuid())
  jobNumber  String   @unique @map("job_number")

  customerId String   @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // A lead can be converted into at most one job — the @unique constraint
  // is the DB-level backstop for "no duplicate job from the same lead",
  // enforced primarily at the application layer in /api/leads/[id]/book.
  leadId String? @unique @map("lead_id")
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  service          String
  serviceAddress   String?   @map("service_address")
  city             String?
  province         String    @default("Ontario")
  postalCode       String?   @map("postal_code")
  scheduledDate    DateTime  @map("scheduled_date")
  startTime        String?   @map("start_time")
  estimatedDuration String?  @map("estimated_duration")
  quotedPrice      Decimal?  @map("quoted_price") @db.Decimal(10, 2)
  finalPrice       Decimal?  @map("final_price") @db.Decimal(10, 2)
  status           JobStatus @default(BOOKED)
  notes            String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([status])
  @@index([scheduledDate])
  @@map("jobs")
}
