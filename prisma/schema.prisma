// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  EMPLOYEE
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(EMPLOYEE)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

enum CustomerStatus {
  LEAD
  ACTIVE_CUSTOMER
  PAST_CUSTOMER
  DO_NOT_CONTACT
}

model Customer {
  id             String         @id @default(cuid())
  firstName      String         @map("first_name")
  lastName       String         @map("last_name")
  phone          String
  email          String?
  streetAddress  String?        @map("street_address")
  city           String?
  province       String         @default("Ontario")
  postalCode     String?        @map("postal_code")
  notes          String?
  status         CustomerStatus @default(LEAD)

  emailMarketingConsent Boolean @default(false) @map("email_marketing_consent")
  smsMarketingConsent   Boolean @default(false) @map("sms_marketing_consent")
  doNotContact          Boolean @default(false) @map("do_not_contact")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([phone])
  @@index([email])
  @@index([lastName, firstName])
  @@map("customers")
}
